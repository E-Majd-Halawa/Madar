NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/madar?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-string-at-least-32-chars"
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=25
ENABLE_DEMO_LOGIN=true
THROTTLE_ENABLED=true
THROTTLE_STRICT_LIMIT=10
THROTTLE_WRITE_LIMIT=60
THROTTLE_READ_LIMIT=300
PUBLIC_WEB_URL=http://localhost:5173
