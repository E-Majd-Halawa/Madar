// Madar (مدار) — initial schema (Phase 1)
// Only users, workspaces and workspace membership for now.
// Source of truth: frontend/src/types/index.ts and frontend/src/types/members.ts
// Mapped to snake_case tables per frontend/docs/backend/02-data-model.md §2–3.3

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  moderator
  admin
  super_admin
}

enum UserStatus {
  active
  suspended
  invited
}

enum WorkspaceType {
  personal
  team
}

enum WorkspaceRole {
  owner
  admin
  member
  guest
}

enum SecurityEventType {
  failed_login
  session
  suspicious
  password_change
  role_change

  @@map("security_event_type")
}

model User {
  id           String   @id
  fullName     String   @map("full_name")
  username     String   @unique
  email        String   @unique
  role         Role     @default(user)
  status       UserStatus @default(active)
  avatarUrl    String?  @map("avatar_url")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")

  memberships         WorkspaceMember[]
  ownedWorkspaces     Workspace[]          @relation("WorkspaceOwner")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  securityEvents      SecurityEvent[]

  @@map("users")
}

model Workspace {
  id          String        @id
  name        String
  description String
  type        WorkspaceType
  ownerId     String        @map("owner_id")
  color       String
  createdAt   DateTime      @default(now()) @map("created_at")

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members WorkspaceMember[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(member)
  department  String?
  status      UserStatus    @default(active)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  ip           String?
  userAgent    String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model SecurityEvent {
  id                String            @id @default(cuid())
  type              SecurityEventType
  descriptionKey    String            @map("description_key")
  descriptionParams Json?             @map("description_params")
  ip                String?
  device            String?
  userId            String?           @map("user_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  revoked           Boolean?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("security_events")
}
